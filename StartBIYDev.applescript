-- BIY development environment: Django, React, the study worker and an import/tools shell: one iTerm window, one stacked pane per service.
property projectID : "biy"

on run
	-- The repo is the folder holding this launcher, so it works in any clone or fork.
	set projectRoot to do shell script "dirname " & quoted form of (POSIX path of (path to me))

	if not iTermInstalled() then
		display alert "iTerm2 is required" message "Install it from https://iterm2.com, then run this launcher again."
		return
	end if
	set missingTools to loginShell(projectRoot, "for t in 'npm'; do command -v \"$t\" >/dev/null || printf \"%s \" \"$t\"; done")
	if missingTools is not "" then
		display alert ("BIY needs " & missingTools) message "Install the missing tools (they must be on your login shell's PATH), then run this launcher again."
		return
	end if

	tell application "Finder" to set screenBounds to bounds of window of desktop

	tell application "iTerm"
		activate
		-- Rerunning replaces this project's window; other iTerm windows are untouched.
		repeat with existingWindow in windows
			try
				repeat with existingSession in sessions of current tab of existingWindow
					tell existingSession to set existingTag to variable named "user.launcherProject"
					if existingTag is my projectID then
						close existingWindow
						exit repeat
					end if
				end repeat
			end try
		end repeat

		set devWindow to (create window with default profile)
		set bounds of devWindow to {0, 0, (item 3 of screenBounds) * 0.75, item 4 of screenBounds}

		-- Backend: Django API
		set paneBackend to current session of devWindow
		tell paneBackend
			set variable named "user.launcherProject" to my projectID
			set variable named "user.launcherPane" to "Backend"
			set name to "BIY · Backend"
			write text "cd " & quoted form of projectRoot
			write text "export BIY_BACKEND_PORT=${BIY_BACKEND_PORT:-8017} BIY_FRONTEND_PORT=${BIY_FRONTEND_PORT:-5178}"
			write text "source .venv/bin/activate"
			write text "pids=$(lsof -t -iTCP:$BIY_BACKEND_PORT -sTCP:LISTEN 2>/dev/null); [ -z \"$pids\" ] || { kill $pids 2>/dev/null; sleep 0.5; pids=$(lsof -t -iTCP:$BIY_BACKEND_PORT -sTCP:LISTEN 2>/dev/null); [ -z \"$pids\" ] || kill -9 $pids 2>/dev/null; }; true"
			write text "python backend/manage.py check && python backend/manage.py runserver 127.0.0.1:$BIY_BACKEND_PORT"
		end tell
		set lastPane to paneBackend

		-- Frontend: Vite frontend
		tell lastPane to set paneFrontend to (split horizontally with default profile)
		tell paneFrontend
			set variable named "user.launcherProject" to my projectID
			set variable named "user.launcherPane" to "Frontend"
			set name to "BIY · Frontend"
			write text "cd " & quoted form of (projectRoot & "/frontend")
			write text "export BIY_BACKEND_PORT=${BIY_BACKEND_PORT:-8017} BIY_FRONTEND_PORT=${BIY_FRONTEND_PORT:-5178}"
			write text "pids=$(lsof -t -iTCP:$BIY_FRONTEND_PORT -sTCP:LISTEN 2>/dev/null); [ -z \"$pids\" ] || { kill $pids 2>/dev/null; sleep 0.5; pids=$(lsof -t -iTCP:$BIY_FRONTEND_PORT -sTCP:LISTEN 2>/dev/null); [ -z \"$pids\" ] || kill -9 $pids 2>/dev/null; }; true"
			write text "npm run dev -- --strictPort --port $BIY_FRONTEND_PORT"
		end tell
		set lastPane to paneFrontend

		-- Worker: Durable PostgreSQL queue: one worker for chat and vector indexing
		tell lastPane to set paneWorker to (split horizontally with default profile)
		tell paneWorker
			set variable named "user.launcherProject" to my projectID
			set variable named "user.launcherPane" to "Worker"
			set name to "BIY · Worker"
			write text "cd " & quoted form of projectRoot
			write text "export BIY_BACKEND_PORT=${BIY_BACKEND_PORT:-8017} BIY_FRONTEND_PORT=${BIY_FRONTEND_PORT:-5178}"
			write text "source .venv/bin/activate"
			write text "python backend/manage.py migrate --noinput && python backend/manage.py index_study && python backend/manage.py study_worker"
		end tell
		set lastPane to paneWorker

		-- Tools: Ready-to-use project and import shell
		tell lastPane to set paneTools to (split horizontally with default profile)
		tell paneTools
			set variable named "user.launcherProject" to my projectID
			set variable named "user.launcherPane" to "Tools"
			set name to "BIY · Tools"
			write text "cd " & quoted form of projectRoot
			write text "export BIY_BACKEND_PORT=${BIY_BACKEND_PORT:-8017} BIY_FRONTEND_PORT=${BIY_FRONTEND_PORT:-5178}"
			write text "source .venv/bin/activate"
			write text "git status --short"
			write text "printf '%s\\n' " & quoted form of ("") & " " & quoted form of ("Import one day:") & " " & quoted form of ("  python backend/manage.py import_podcasts --day 1") & " " & quoted form of ("") & " " & quoted form of ("Refresh episode list only (no audio or AI):") & " " & quoted form of ("  python backend/manage.py import_podcasts --all --catalog-only") & " " & quoted form of ("") & " " & quoted form of ("Resume the full import:") & " " & quoted form of ("  python backend/manage.py import_podcasts --all --workers 4") & " " & quoted form of ("")
		end tell
		set lastPane to paneTools
	end tell

	-- Open the app in the default browser once its server answers.
	do shell script "(" & "for i in $(seq 1 240); do nc -z 127.0.0.1 5178 2>/dev/null && break; sleep 0.5; done; " & "open " & quoted form of ("http://localhost:5178" & "/") & ") >/dev/null 2>&1 &"
end run

on iTermInstalled()
	try
		do shell script "open -Ra iTerm"
		return true
	on error
		return false
	end try
end iTermInstalled

-- Runs a command in a login shell at the repo root, so tools on the user's PATH (Homebrew, nvm, uv) are found.
on loginShell(projectRoot, command)
	return do shell script "/bin/zsh -lc " & quoted form of ("cd " & quoted form of projectRoot & " && " & command)
end loginShell
