  "spec": 1,
  "id": "biy",
  "name": "BIY",
  "launcher": "StartBIYDev",
  "description": "BIY development environment: Django, React, the study worker and an import/tools shell",
  "url": "http://localhost:{port:Frontend}/",
  "requires": [
