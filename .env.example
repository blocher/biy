DJANGO_SECRET_KEY=replace-with-a-random-secret
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DATABASE_URL=postgresql:///biy
OPENAI_API_KEY=
OPENAI_TRANSCRIBE_MODEL=gpt-4o-transcribe-diarize
OPENAI_STUDY_MODEL=gpt-6-astra
BIBLE_SOURCE_DIR=/Applications/Bible - Catholic Study.app/Contents/Resources/bibles/rsv_ce_study_nt_ot/text

CSRF_TRUSTED_ORIGINS=http://127.0.0.1:5178,http://localhost:5178

# Initial shared date; members can subsequently edit it from Account.
LEADERBOARD_START_DATE=2026-09-20
PUBLIC_APP_URL=http://localhost:5178
# Optional SMTP: missing host/user/password/from skips notifications.
DJANGO_EMAIL_HOST=
DJANGO_EMAIL_PORT=587
DJANGO_EMAIL_HOST_USER=
DJANGO_EMAIL_HOST_PASSWORD=
DJANGO_EMAIL_USE_TLS=true
DJANGO_DEFAULT_FROM_EMAIL=
BIY_EMAIL_DELIVERY_MODE=redirect
DJANGO_EMAIL_REDIRECT_TO=
