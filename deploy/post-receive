#!/bin/sh
# Installed only after explicit production provisioning; this push deploys live.
set -eu
REPO_DIR=/var/repo/biy.git
APP_ROOT=/var/www/biy-app
WEB_ROOT=/var/www/biy.benlocher.com
DEPLOY_REV=''
while read -r oldrev newrev ref; do
    if [ "$ref" = refs/heads/main ] && [ "$newrev" != 0000000000000000000000000000000000000000 ]; then DEPLOY_REV="$newrev"; fi
done
[ -n "$DEPLOY_REV" ] || exit 0
exec 9>/var/lock/biy-deploy.lock
flock -n 9 || { echo 'Another BIY deployment is running'; exit 1; }
systemctl stop biy biy-worker || true
git --work-tree="$APP_ROOT" --git-dir="$REPO_DIR" checkout -f "$DEPLOY_REV"
chown -R biy:biy "$APP_ROOT"
usermod -aG biy www-data
if [ ! -x "$APP_ROOT/.venv/bin/python" ]; then sudo -u biy python3.13 -m venv "$APP_ROOT/.venv"; fi
sudo -u biy "$APP_ROOT/.venv/bin/pip" install -r "$APP_ROOT/backend/requirements.txt"
# pgvector must be installed for the server's PostgreSQL major version first.
# Extension creation is performed by postgres, never by elevating the application role.
sudo -u postgres psql -d biy -v ON_ERROR_STOP=1 -c 'CREATE EXTENSION IF NOT EXISTS vector'
"$APP_ROOT/deploy/manage" migrate --noinput
"$APP_ROOT/deploy/manage" seed_plan
"$APP_ROOT/deploy/manage" create_account ben --seed
"$APP_ROOT/deploy/manage" collectstatic --noinput
cd "$APP_ROOT/frontend"
sudo -u biy -H npm ci
sudo -u biy -H npm run build
mkdir -p "$WEB_ROOT"
rm -rf "$WEB_ROOT/dist.previous"
if [ -d "$WEB_ROOT/dist" ]; then mv "$WEB_ROOT/dist" "$WEB_ROOT/dist.previous"; fi
cp -a dist "$WEB_ROOT/dist"
chmod -R a+rX "$WEB_ROOT/dist"
"$APP_ROOT/deploy/manage" index_study
install -m 0644 "$APP_ROOT/deploy/biy-worker.service" /etc/systemd/system/biy-worker.service
systemctl daemon-reload
systemctl enable biy-worker
systemctl restart nginx
systemctl start biy-worker biy
systemctl is-active --quiet biy-worker biy
echo "BIY deployed at $DEPLOY_REV. Podcast imports are never run by this hook."
