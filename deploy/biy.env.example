DJANGO_SECRET_KEY=replace-privately
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=biy.benlocher.com,localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=https://biy.benlocher.com
DATABASE_URL=postgresql:///biy?host=/var/run/postgresql
MEDIA_ROOT=/var/lib/biy/media
OPENAI_API_KEY=
OPENAI_TRANSCRIBE_MODEL=gpt-4o-transcribe-diarize
OPENAI_IMPORT_TIMEOUT_SECONDS=900
OPENAI_STUDY_MODEL=gpt-4.1
BIBLE_SOURCE_DIR=/var/lib/biy/bible-source

# Study chat: OpenAI orchestrates local tools; Magisterium supplies Catholic sources.
MAGISTERIUM_API_KEY=
STUDY_CHAT_MODEL=gpt-5.6-luna
STUDY_CHAT_QUALITY_MODEL=gpt-5.6-terra
STUDY_WEB_MODEL=gpt-5.6-luna
STUDY_EMBEDDING_MODEL=text-embedding-3-small
STUDY_CHAT_DAILY_LIMIT=100
